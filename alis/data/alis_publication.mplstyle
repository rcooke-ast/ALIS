# The publication style of ALIS's plotting scripts (dashboard Stage 9; D42, Q0.7,
# Q0.10), from the matplotlibrc of RJC's published figures. The figures written by
# the dashboard's Figure tab use it; nothing else in ALIS or the dashboard does.
#
# Left out of RJC's file: the backend and web-server entries, which a style file
# does not take; figure.autolayout, since each script sets its own spacing; and
# figure.max_open_warning. Added: DejaVu Serif at the end of font.serif, so that a
# machine without the other serif fonts falls back quietly. text.usetex is True
# here; each script turns it off where no LaTeX is installed.
#
# Generated by RJC and Claude.
lines.linewidth           : 2.0
lines.linestyle           : -
lines.color               : black
lines.marker              : None
lines.markeredgewidth     : 0.0
lines.markersize          : 6.0
lines.solid_joinstyle     : round
lines.solid_capstyle      : round
lines.antialiased         : True
patch.linewidth           : 1.0
patch.facecolor           : 0.75
patch.edgecolor           : 0.5
patch.antialiased         : True
font.family               : serif
font.style                : normal
font.variant              : normal
font.weight               : bold
font.stretch              : normal
font.size                 : 14.0
font.serif                : Computer Modern Roman, Times, Palatino, New Century Schoolbook, Bookman, DejaVu Serif
font.sans-serif           : Helvetica, Arial, Avant Garde, Computer Modern Sans serif
font.cursive              : Zapf Chancery, Sand, cursive
font.fantasy              : Comic Sans MS, Chicago, Charcoal, Impact, Western, fantasy
font.monospace            : Source Code Pro, Courier, Computer Modern Typewriter
text.color                : black
text.usetex               : True
text.latex.preamble       : \usepackage{bm}
mathtext.default          : regular
axes.facecolor            : white
axes.edgecolor            : black
axes.linewidth            : 1.0
axes.grid                 : False
axes.titlesize            : 16
axes.labelsize            : 16
axes.labelweight          : bold
axes.axisbelow            : True
axes.formatter.limits     : -7, 7
axes.formatter.use_mathtext: True
axes.xmargin              : 0
axes.ymargin              : 0
polaraxes.grid            : True
xtick.major.size          : 8
xtick.minor.size          : 4
xtick.major.width         : 1
xtick.minor.width         : 1
xtick.major.pad           : 6
xtick.color               : k
xtick.labelsize           : 14
xtick.direction           : in
ytick.major.size          : 8
ytick.minor.size          : 4
ytick.major.width         : 1
ytick.minor.width         : 1
ytick.major.pad           : 6
ytick.color               : k
ytick.labelsize           : 14
ytick.direction           : in
grid.color                : 0.7
grid.linestyle            : -
grid.alpha                : 0.2
legend.fancybox           : True
figure.figsize            : 8, 5
figure.dpi                : 150
figure.facecolor          : white
savefig.dpi               : 150
savefig.format            : pdf
savefig.bbox              : standard
savefig.pad_inches        : 0.0

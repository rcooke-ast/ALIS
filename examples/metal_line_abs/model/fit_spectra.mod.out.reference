run blind False
run datadirc ../data/
chisq ftol 1.0E-10
chisq atol 0.001
chisq miniter 10
chisq maxiter 1000
out fits True
out overwrite True
out plots fit_spectra.pdf
out covar fit_spectra.covar
plot dims 2x2
plot fits False
plot labels True

data read
  OI_SiII.dat  specid=0  fitrange=[1301.0,1305.0]  resolution=vfwhm(7.000VA)  columns=[wave,flux,error]  plotone=True  label=OI_SiII  bufferpix=[12,12]
data end

model read
  fix voigt temperature True
 emission
  legendre   1.00005846      -7.90284492E-04  -0.00474372      specid=0      scale=1.0,1.0,1.0        
 absorption
  voigt   ion=16O_I    13.9851970      -5.174350315529E-07  5.088151da      8.0000000E+03TA        specid=0              
  voigt   ion=28Si_II  13.0411835      -1.937779694435E-06  5.088151da      8.0000000E+03TA        specid=0              
model end


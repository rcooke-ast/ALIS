data end

model read
  lim gaussian amplitude  None,None
 emission
  gaussian   10.65938306ha      -9.94442651E-07za  28.22145570ba      specid=0      wave=6563.0      
  gaussian   -0.07811054nii      -9.94442651E-07za  28.22145570ba      specid=0      wave=6584.0      
  variable   -0.00732787ratio                
model end

link read
  nii(ratio,ha) = ratio*ha
link end


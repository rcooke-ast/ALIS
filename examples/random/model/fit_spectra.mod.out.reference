#   Convergence Reason  = The relative reduction in the sum of squares is less than atol

run blind False
run datadirc ../data/
chisq ftol 1.0E-10
chisq atol 0.001
chisq miniter 10
chisq maxiter 1000
out fits True
out overwrite True
out plots fit_spectra.pdf
plot dims 2x2
plot fits False
plot labels True

data read
  OI_SiII.dat  specid=0  fitrange=[1301.0,1305.0]  resolution=vfwhm(7.000VA)  columns=[wave,flux,error]  plotone=True  label=OI_SiII
data end

model read
  fix voigt temperature True
 emission
  legendre   1.00486731      -0.00318786      0.01542137      specid=0      scale=1.0,1.0,1.0    
 absorption
  voigt   ion=16O_I    13.9717114      -1.317638332653E-07  5.478215da      8.0000000E+03TA        specid=0              
  voigt   ion=28Si_II/16O_I  -0.9833585rat      specid=0              
  random   -0.98335853ratrand          blind=False  command=uniform(-2.0,0.0)      
model end

link read
  rat(ratrand) = ratrand
link end


run blind False
run datadirc ../data/
chisq ftol 1.0E-10
chisq atol 0.001
chisq miniter 10
chisq maxiter 1000
out fits True
out overwrite True
out plots fit_spectra.pdf
plot dims 2x2
plot fits False
plot labels True

data read
  OI_SiII_powerlaw.dat  specid=0  loadrange=all  fitrange=[1301.0,1305.0]  resolution=vfwhm(7.000VA)  columns=[wave,flux,error]  plotone=True  label=OI_SiII
data end

model read
  fix voigt temperature True
 emission
  powerlaw   0.97416843      0.30364884              
 absorption
  voigt   ion=16O_I    14.0000058      -1.462424134654E-10ra  4.998963da      8.0000000E+03TA        specid=0              
  voigt   ion=28Si_II  12.9997532      -1.462424134654E-10ra  4.998963da      8.0000000E+03TA        specid=0              
model end


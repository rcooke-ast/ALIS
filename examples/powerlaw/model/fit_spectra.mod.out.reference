#   Convergence Reason  = The relative reduction in the sum of squares is less than atol

run blind False
run datadirc ../data/
chisq ftol 1.0E-10
chisq atol 0.001
chisq miniter 10
chisq maxiter 1000
out fits True
out overwrite True
plot dims 2x2
plot fits False
plot labels True

# --- applied from the command line ---
plot dims 0   #[cli] was 3x3
out fits True   #[cli] was False
# The following were also given on the command line, but describe
# that run rather than this model, so they are recorded only:
#   out overwrite True    (was False)
# --- end of command-line overrides ---

data read
  OI_SiII_powerlaw.dat  specid=0  loadrange=all  fitrange=[1301.0,1305.0]  resolution=vfwhm(7.000VA)  columns=[wave,flux,error]  plotone=True  label=OI_SiII
data end

model read
  fix voigt temperature True
 emission
  powerlaw   1.28801090      0.26470967              
 absorption
  voigt   ion=16O_I    13.9996883      -1.987985703029E-10ra  4.838546da      8.0000000E+03TA        specid=0              
  voigt   ion=28Si_II  12.9970013      -1.987985703029E-10ra  4.838546da      8.0000000E+03TA        specid=0              
model end


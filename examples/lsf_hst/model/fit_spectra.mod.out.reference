run backend cpu
run blind False
run datadirc ../data/
chisq ftol 1.0E-10
chisq atol 0.001
chisq miniter 10
chisq maxiter 1000
out fits True
out overwrite True
plot dims 2x2
plot fits False
plot labels True

# --- applied from the command line ---
plot dims 0   #[cli] was 3x3
out fits True   #[cli] was False

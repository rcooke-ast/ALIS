data read
  OI_SiII.dat  specid=0  fitrange=[1301.0,1305.0]  resolution=lsf(name:STIS,grating:E140H,slit:0.2x0.09)  columns=[wave,flux,error]  plotone=True  label=OI_SiII  bufferpix=[3492,3490]  nsubpixel=10
data end

model read
  fix voigt temperature True
 emission
  legendre   1.00005191      2.30824385E-04  -0.00207159      specid=0      scale=1.0,1.0,1.0        
 absorption
  voigt   ion=16O_I    13.9989946      4.461218714133E-07  4.811773da      8.0000000E+03TA        specid=0              
  voigt   ion=28Si_II  12.9964474      2.312155124346E-07  4.811773da      8.0000000E+03TA        specid=0              
model end


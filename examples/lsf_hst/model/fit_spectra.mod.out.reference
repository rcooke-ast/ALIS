data read
  OI_SiII.dat  specid=0  fitrange=[1301.0,1305.0]  resolution=lsf(name:STIS,grating:E140H,slit:0.2x0.09)  columns=[wave,flux,error]  plotone=True  label=OI_SiII  bufferpix=[3492,3490]
data end

model read
  fix voigt temperature True
 emission
  legendre   1.00005191      2.30849715E-04  -0.00207157      specid=0      scale=1.0,1.0,1.0        
 absorption

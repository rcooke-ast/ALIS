run blind False
run datadirc ../data/
chisq ftol 1.0E-10
chisq atol 0.001
chisq miniter 10
chisq maxiter 1000
out fits True
out overwrite True
out plots fit_spectra.pdf
plot dims 2x2
plot fits False
plot labels True

data read
  OI_SiII_chebyshev.dat  specid=0  fitrange=[1301.0,1305.0]  resolution=vfwhm(7.000VA)  columns=[wave,flux,error]  plotone=True  label=OI_SiII
data end

model read
  fix voigt temperature True
 emission
  chebyshev   0.99915837      0.00170786      -0.00253377                
 absorption
  voigt   ion=16O_I    13.9988939      5.430700233565E-07  5.104306da      8.0000000E+03TA        specid=0              
  voigt   ion=28Si_II  13.0445199      5.894416649731E-07  5.104306da      8.0000000E+03TA        specid=0              
model end


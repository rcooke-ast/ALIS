run blind False
run datadirc ../data/
chisq ftol 1.0E-10
chisq atol 0.001
chisq miniter 10
chisq maxiter 1000
out fits True
out overwrite True
out plots fit_spectra.pdf
plot dims 2x2
plot fits False
plot labels True

data read
  OI_SiII_chebyshev.dat  specid=0  fitrange=[1301.0,1305.0]  resolution=vfwhm(7.000VA)  columns=[wave,flux,error]  plotone=True  label=OI_SiII  bufferpix=[12,12]
data end

model read
  fix voigt temperature True
 emission
  chebyshev   0.99911591      0.00161896      -0.00257408                
 absorption
  voigt   ion=16O_I    13.9988456      5.432758411197E-07  4.945474da      8.0000000E+03TA        specid=0              
  voigt   ion=28Si_II  13.0408569      5.519597664680E-07  4.945474da      8.0000000E+03TA        specid=0              
model end


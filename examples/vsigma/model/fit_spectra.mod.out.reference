run blind False
run datadirc ../data/
chisq ftol 1.0E-10
chisq atol 0.001
chisq miniter 10
chisq maxiter 1000
out fits True
out overwrite True
plot dims 2x2
plot fits False
plot labels True

data read
  OI_SiII.dat  specid=0  fitrange=[1301.0,1305.0]  resolution=vsigma(7.000VA)  columns=[wave,flux,error]  plotone=True  label=OI_SiII  bufferpix=[28,28]
data end

model read
  fix voigt temperature True
 emission
  legendre   1.00131717      -0.00939277      -0.01478167      specid=0      scale=1.0,1.0,1.0        
 absorption
  voigt   ion=16O_I    14.0106174      7.940461397746E-08ra  5.025941da      8.0000000E+03TA        specid=0              
  voigt   ion=28Si_II  12.9166553      7.940461397746E-08ra  5.025941da      8.0000000E+03TA        specid=0              
model end


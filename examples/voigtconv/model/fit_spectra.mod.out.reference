run blind False
run datadirc ../data/
chisq ftol 1.0E-10
chisq atol 0.001
chisq miniter 10
chisq maxiter 1000
out fits True
out overwrite True
plot dims 2x2
plot fits False
plot labels True

# --- applied from the command line ---
plot dims 0   #[cli] was 3x3
out fits True   #[cli] was False
# The following were also given on the command line, but describe
# that run rather than this model, so they are recorded only:
#   out overwrite True    (was False)
# --- end of command-line overrides ---

data read
  OI_SiII.dat  specid=0  loadrange=all  fitrange=[1301.0,1305.0]  resolution=voigtconv(7.000VA,4.018)  columns=[wave,flux,error]  plotone=True  label=OI_SiII
data end

model read
  fix voigt temperature True
 emission
  legendre   1.14916969      -0.01612063      0.29877182      specid=0      scale=1.0,1.0,1.0        
 absorption
  voigt   ion=16O_I    14.0548133      -3.478548354544E-08ra  4.068022da      8.0000000E+03TA        specid=0              
  voigt   ion=28Si_II  13.0264642      -3.478548354544E-08ra  4.068022da      8.0000000E+03TA        specid=0              
model end


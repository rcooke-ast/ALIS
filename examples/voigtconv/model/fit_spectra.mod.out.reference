run blind False
run datadirc ../data/
chisq ftol 1.0E-10
chisq atol 0.001
chisq miniter 10
chisq maxiter 1000
out fits True
out overwrite True
plot dims 2x2
plot fits False
plot labels True

data read
  OI_SiII.dat  specid=0  loadrange=all  fitrange=[1301.0,1305.0]  resolution=voigtconv(7.000VA,4.018)  columns=[wave,flux,error]  plotone=True  label=OI_SiII
data end

model read
  fix voigt temperature True
 emission
  legendre   1.14916909      -0.01612066      0.29877061      specid=0      scale=1.0,1.0,1.0        
 absorption
  voigt   ion=16O_I    14.0548133      -3.478548263900E-08ra  4.068023da      8.0000000E+03TA        specid=0              
  voigt   ion=28Si_II  13.0264642      -3.478548263900E-08ra  4.068023da      8.0000000E+03TA        specid=0              
model end


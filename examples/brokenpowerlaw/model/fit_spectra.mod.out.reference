run blind False
run datadirc ../data/
chisq ftol 1.0E-10
chisq atol 0.001
chisq miniter 10
chisq maxiter 1000
out fits True
out overwrite True
plot dims 2x2
plot fits False
plot labels True

data read
  OI_SiII_brokenpowerlaw.dat  specid=0  fitrange=[1301.0,1305.0]  resolution=vfwhm(7.000VA)  columns=[wave,flux,error]  plotone=True  label=OI_SiII
data end

model read
  fix voigt temperature True
 emission
  brokenpowerlaw   0.99997541      0.33958057      -0.31759508      1.30300000E+03LOC  1.00000000E+04STR          
 absorption
  voigt   ion=16O_I    14.0000970      -1.184882269292E-10ra  4.997625da      8.0000000E+03TA        specid=0              
  voigt   ion=28Si_II  12.9999105      -1.184882269292E-10ra  4.997625da      8.0000000E+03TA        specid=0              
model end


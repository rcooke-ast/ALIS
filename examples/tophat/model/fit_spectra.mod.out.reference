run blind False
run datadirc ../data/
chisq ftol 1.0E-10
chisq atol 0.001
chisq miniter 10
chisq maxiter 1000
out fits True
out overwrite True
out plots fit_spectra.pdf
plot dims 2x2
plot fits False
plot labels True

data read
  OI_SiII_tophat.dat  specid=0  fitrange=[1301.0,1305.0]  resolution=vfwhm(7.000VA)  columns=[wave,flux,error]  plotone=True  label=OI_SiII
data end

model read
  fix voigt temperature True
 emission
  tophat   0.99882860      0.50560444      1.30300000E+03CENT  3.00000000WID                  
 absorption
  voigt   ion=16O_I    14.0105175      -2.965047361482E-07  5.275449da      8.0000000E+03TA        specid=0              
  voigt   ion=28Si_II  13.0030913      1.755484740245E-06  5.275449da      8.0000000E+03TA        specid=0              
model end


run blind False
run datadirc ../data/
chisq ftol 1.0E-10
chisq atol 0.001
chisq miniter 10
chisq maxiter 1000
out fits True
out overwrite True
out plots fit_spectra.pdf
plot dims 2x2
plot fits False
plot labels True

data read
  OI_SiII_polynomial.dat  specid=0  fitrange=[1301.0,1305.0]  resolution=vfwhm(7.000VA)  columns=[wave,flux,error]  plotone=True  label=OI_SiII
data end

model read
  fix voigt temperature True
 emission
  polynomial   1.57397704      -4.37738635E-04            
 absorption
  voigt   ion=16O_I    14.0224319      2.127505251061E-07  4.634208da      8.0000000E+03TA        specid=0              
  voigt   ion=28Si_II  13.0276355      -4.577738193262E-06  4.634208da      8.0000000E+03TA        specid=0              
model end

